  "description": "BlueWallet - Web Edition",
  "license": "MIT",
  "lif": {
    "webapp": "./web/main.tsx",
    "spa": true,
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6"
    },
    "web_exports": {
      "./img/*": "./img/*"
    },
    "alt": [
      ".js",
      ".ts",
      ".tsx",
      ".jsx",
      "/index.js",
      "/index.ts",
      "/index.tsx"
    ],
    "transform": {
      "./**/*.js": {
        "type": "jsx"
      }
    },
    "patch": {
      "@react-navigation/elements": {
        "./lib/module/index.js": {
          "import backIcon from './assets/back-icon.png';": "const backIcon = import.meta.resolve('./assets/back-icon.png');",
          "import backIconMask from './assets/back-icon-mask.png';": "const backIconMask = import.meta.resolve('./assets/back-icon-mask.png');",
          "import clearIcon from './assets/clear-icon.png';": "const clearIcon = import.meta.resolve('./assets/clear-icon.png');",
          "import closeIcon from './assets/close-icon.png';": "const closeIcon = import.meta.resolve('./assets/close-icon.png');",
          "import searchIcon from './assets/search-icon.png';": "const searchIcon = import.meta.resolve('./assets/search-icon.png');"
        },
        "./lib/module/Header/HeaderBackButton.js": {
          "import backIcon from '../assets/back-icon.png';": "const backIcon = import.meta.resolve('../assets/back-icon.png');",
          "import backIconMask from '../assets/back-icon-mask.png';": "const backIconMask = import.meta.resolve('../assets/back-icon-mask.png');"
        },
        "./lib/module/Header/Header.js": {
          "import searchIcon from '../assets/search-icon.png';": "const searchIcon = import.meta.resolve('../assets/search-icon.png');"
        },
        "./lib/module/Header/HeaderSearchBar.js": {
          "import clearIcon from '../assets/clear-icon.png';": "const clearIcon = import.meta.resolve('../assets/clear-icon.png');",
          "import closeIcon from '../assets/close-icon.png';": "const closeIcon = import.meta.resolve('../assets/close-icon.png');",
          "import searchIcon from '../assets/search-icon.png';": "const searchIcon = import.meta.resolve('../assets/search-icon.png');"
        }
      },
      "@react-navigation/drawer": {
        "./lib/module/views/DrawerToggleButton.js": {
          "import toggleDrawerIcon from './assets/toggle-drawer-icon.png';": "const toggleDrawerIcon = import.meta.resolve('./assets/toggle-drawer-icon.png');"
        },
        "./lib/module/views/ScreenFallback.js": {
          "Screens = require('react-native-screens');": "Screens = await import('react-native-screens');"
        }
      },
      "react-native-web": {
        "./dist/index.js": {
          "export { default as useWindowDimensions } from './exports/useWindowDimensions';": "export { default as useWindowDimensions } from './exports/useWindowDimensions';\nexport function codegenNativeComponent(name){ return (props)=>null; }\nexport function PlatformColor(){ return undefined; }"
        }
      },
      "@react-navigation/devtools": {
        "./lib/module/index.js": {
          "if (process.env.NODE_ENV !== 'production') {\n  useLogger = require('./useLogger').useLogger;\n  useReduxDevToolsExtension = require('./useReduxDevToolsExtension').useReduxDevToolsExtension;\n} else {\n  useLogger = noop;\n  useReduxDevToolsExtension = noop;\n}": "useLogger = noop;\nuseReduxDevToolsExtension = noop;"
        }
      }
    }
  },
  "overrides": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
